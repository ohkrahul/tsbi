# Payload
PAYLOAD_SECRET=replace-with-a-long-random-string
# Neon Postgres (reuse the same DB as the frontend; Payload creates its own tables)
DATABASE_URI=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Vercel Blob (image uploads). Leave empty to store uploads on local disk in dev.
BLOB_READ_WRITE_TOKEN=
# CORS / where the public site lives (for admin + API cross-origin)
FRONTEND_URL=http://localhost:3000
